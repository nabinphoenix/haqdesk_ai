  Customer --> FB[Facebook Messenger]
  Customer --> IG[Instagram Direct]
  Customer --> Email[Email]
  Customer -.-> WA[WhatsApp<br/>Partial / not verified]
  FB --> Meta[Meta webhooks + Graph API]
  IG --> Meta
  Meta --> Webhooks[FastAPI webhook processing]
  Email --> Poller[IMAP poller / SMTP]
  Poller --> Backend
  Webhooks --> Backend[FastAPI backend]
  Backend --> Auth[JWT authentication + RBAC]
  Backend --> Inbox[Inbox + conversation management]
  Backend --> RAG[AI / RAG service]
  Backend --> Analytics[Analytics service]
  Backend --> Team[Team + business settings]
  Dashboard[Next.js dashboard<br/>Inbox • Knowledge • Analytics • Team • Settings] <-->|secured APIs| Backend
  Backend --> PG[(PostgreSQL<br/>businesses, users, customers, conversations,<br/>messages, integrations, knowledge metadata)]
  RAG --> Q[(Qdrant<br/>techsuru_collection<br/>business_id filtered)]
  RAG --> LLM[LiteLLM gateway<br/>Groq primary + configured fallbacks]
  Backend --> Files[Local file storage<br/>temporary ingestion + chat attachments]
  Backend -->|approved reply| Meta
  Meta --> FB
  Meta --> IG
  Analytics -->|tenant aggregates| PG
  Security[Every business query is restricted<br/>by authenticated business_id] --- Backend

  class Backend,Webhooks,Auth,Inbox,RAG,Analytics,Team,Meta,LLM,Q core;
  class PG,Files data;
  class Customer,FB,IG,Email,Poller,Dashboard external;
  class WA partial;

