  classDef core fill:#F4F1FF,stroke:#6D4AE2,stroke-width:2px,color:#0F172A;
  classDef data fill:#F8FAFC,stroke:#475569,stroke-width:2px,color:#0F172A;
  classDef external fill:#FFFFFF,stroke:#E2E8F0,stroke-width:2px,color:#0F172A;
