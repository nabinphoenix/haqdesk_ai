        <mxCell id="e_agent_browser" value="A1 Open conversation / review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="agent" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_super_browser" value="Uses" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="superadmin" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_browser_next" value="Browser navigation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="browser" target="nextjs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_next_api" value="T4 / A2 HTTPS REST + JSON/multipart + JWT Bearer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;startArrow=block;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1" source="nextjs" target="api"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="e_cust_fb" value="M1 Customer message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="customer" target="facebook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_cust_ig" value="M1 Customer message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="customer" target="instagram"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_fb_hook" value="M2 Incoming message event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="facebook" target="metawebhook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_ig_hook" value="M2 Incoming message event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="instagram" target="metawebhook"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_hook_webhooksvc" value="M3 Webhook payload" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="metawebhook" target="webhooksvc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_webhook_inbox" value="M4 Verify + normalise; M5 resolve business/customer/conversation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;endArrow=block;endFill=1;" edge="1" parent="1" source="webhooksvc" target="inboxsvc"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e_inbox_pg" value="M6 Persist customer, conversation, message; M14 store outgoing message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;strokeColor=#000000;fontColor=#000000;startArrow=block;startFill=1;endArrow=block;endFill=1;" edge="1" parent="1" source="inboxsvc" target="postgres"><mxGeometry relative="1" as="geometry"/></mxCell>
