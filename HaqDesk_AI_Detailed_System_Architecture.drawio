        <mxCell id="browser" value="Web Browser&#xa;JWT kept client-side; protected requests use Bearer token" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="625" width="205" height="80" as="geometry"/></mxCell>

