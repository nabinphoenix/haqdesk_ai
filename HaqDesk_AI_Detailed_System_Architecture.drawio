        <mxCell id="metawebhook" value="Meta Webhooks&#xa;Verification token + optional HMAC signature&#xa;Message / attachment / status events" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="480" width="235" height="90" as="geometry"/></mxCell>
        <mxCell id="metagraph" value="Meta Graph API v18.0&#xa;OAuth, page discovery, webhook subscription, send replies" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="625" width="235" height="85" as="geometry"/></mxCell>
        <mxCell id="whatsapp" value="WhatsApp Business API&#xa;Planned / Awaiting Meta Business Verification&#xa;Code paths exist but channel is not connected" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="310" y="825" width="235" height="90" as="geometry"/></mxCell>

        <mxCell id="nextjs" value="Next.js 16 Frontend — TypeScript&#xa;React 19 | HTTPS REST/JSON client" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="615" y="135" width="310" height="65" as="geometry"/></mxCell>
        <mxCell id="fe_auth" value="Authentication and Onboarding&#xa;Login, registration, Google callback, password reset, invitation acceptance" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="225" width="310" height="75" as="geometry"/></mxCell>
        <mxCell id="fe_inbox" value="Unified Inbox&#xa;Conversation list, chat panel, customer sidebar, attachments, AI suggestion&#xa;Poll conversations/messages every 3 seconds" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="325" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="fe_kb" value="Knowledge Base&#xa;PDF / DOCX / TXT upload (max 10 MB), document/chunk management, test query&#xa;Poll status every 5 seconds" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="445" width="310" height="95" as="geometry"/></mxCell>
        <mxCell id="fe_analytics" value="Analytics Dashboard&#xa;Messages, AI drafts, conversations, customers, platforms, sentiment, 7-day volume, KB/team counts" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="565" width="310" height="85" as="geometry"/></mxCell>
        <mxCell id="fe_team" value="Team Management&#xa;Invite by email, validate/accept/revoke invitation, view/remove members, roles" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="675" width="310" height="80" as="geometry"/></mxCell>
        <mxCell id="fe_settings" value="Settings and Integrations&#xa;Business profile, review/auto AI mode, Meta OAuth, encrypted Gmail app password" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="780" width="310" height="85" as="geometry"/></mxCell>
        <mxCell id="fe_super" value="Super Admin Dashboard&#xa;Businesses, users, conversations, messages, integrations, AI draft totals" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="615" y="890" width="310" height="75" as="geometry"/></mxCell>

        <mxCell id="api" value="FastAPI Backend — Python&#xa;/api/v1 routers | JSON / multipart | CORS | Session middleware" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="995" y="135" width="640" height="60" as="geometry"/></mxCell>
        <mxCell id="security" value="API Security and Tenant Context&#xa;JWT validation → current user → RBAC (super_admin / business_admin / supervisor / agent)&#xa;Application-level tenant filtering using business_id" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="215" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="authsvc" value="Authentication Module&#xa;Local password hashing, JWT issue/expiry, Google OAuth/OIDC, reset tokens, business creation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="215" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="webhooksvc" value="Meta Integration and Webhook Service&#xa;Verify endpoint/signature; platform handler; tenant resolution by integration recipient; payload normalisation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="335" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="inboxsvc" value="Unified Inbox Services&#xa;Identify/create customer and conversation; persist messages; customer identity linking; read/status/priority; outgoing reply + attachment" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="335" width="320" height="105" as="geometry"/></mxCell>
        <mxCell id="management" value="Business, Team and Settings APIs&#xa;Profile and AI mode; members; invitation lifecycle; integration/OAuth/token management; credential encryption" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="460" width="300" height="100" as="geometry"/></mxCell>
        <mxCell id="analyticssvc" value="Analytics and Super-Admin APIs&#xa;Business-scoped SQL aggregation; platform/sentiment breakdown; message volume; KB/team totals; global control-center summary" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="460" width="320" height="100" as="geometry"/></mxCell>
        <mxCell id="emailpoller" value="Email Integration Service&#xa;Daemon thread polls Gmail IMAP every 30 s; normalises email into inbox; SMTP sends replies/invites/reset links" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="580" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="background" value="FastAPI Background Tasks&#xa;Document ingestion and inbound sentiment/RAG draft generation&#xa;(No operational Celery/Redis/WebSockets)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="580" width="320" height="105" as="geometry"/></mxCell>

        <mxCell id="ingestion" value="Document Ingestion Pipeline&#xa;1 Admin upload → 2 type/size validation → 3 temporary file → 4 PyMuPDF text extraction → 5 Q&amp;A parsing or 500-word chunks / 50-word overlap → status" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="780" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="embedding" value="Embedding Service&#xa;SentenceTransformers BAAI/bge-m3&#xa;Romanized Nepali normalisation&#xa;1024-dimensional vectors" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="780" width="320" height="125" as="geometry"/></mxCell>
        <mxCell id="retrieval" value="RAG Retrieval and Query Processing&#xa;Query embedding → Qdrant cosine similarity search → top-K chunks with business_id filter → sources + confidence (threshold 0.45)" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="925" width="300" height="125" as="geometry"/></mxCell>
        <mxCell id="generation" value="Grounded Response Generation&#xa;Language + BERT sentiment; conversation history; prompt construction; LiteLLM gateway; primary Groq Llama 3.3 70B + Gemini/OpenRouter fallback" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="925" width="320" height="125" as="geometry"/></mxCell>
        <mxCell id="review" value="Human Review Workflow (primary demonstrated flow)&#xa;AI suggestion + sources/confidence → agent accepts, edits, or rejects → approved reply only is dispatched&#xa;Config also contains an implemented optional auto mode" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="995" y="1070" width="640" height="105" as="geometry"/></mxCell>

        <mxCell id="postgres" value="PostgreSQL — Primary Relational Database" style="shape=cylinder;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1710" y="140" width="345" height="80" as="geometry"/></mxCell>
        <mxCell id="pg_groups" value="Business-scoped relational data&#xa;• Businesses + AI response mode&#xa;• Users, roles, invitations, auth/OAuth profile&#xa;• Integrations, page/account IDs, access tokens, encrypted email metadata&#xa;• Customers + linked platform identities&#xa;• Conversations, assignments, status, priority&#xa;• Messages, attachments, AI drafts, language, sentiment, AI metadata&#xa;• Knowledge documents + chunk text/page metadata&#xa;• Analytics derived from operational records&#xa;• Business settings" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1710" y="240" width="345" height="315" as="geometry"/></mxCell>
        <mxCell id="qdrant" value="Qdrant Vector Database&#xa;Collection: techsuru_collection&#xa;Cosine similarity | 1024 dimensions" style="shape=cylinder;whiteSpace=wrap;html=0;boundedLbl=1;backgroundOutline=1;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1710" y="600" width="345" height="100" as="geometry"/></mxCell>
        <mxCell id="qdrant_groups" value="Vector retrieval data only&#xa;• Document chunk vectors&#xa;• Chunk text and chunk_id&#xa;• Source document_id / filename / page&#xa;• business_id tenant metadata&#xa;• Index: upsert embeddings&#xa;• Retrieve: query vector + business filter → top-K chunks&#xa;Remote server with embedded local Qdrant fallback" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;spacingLeft=12;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1710" y="720" width="345" height="230" as="geometry"/></mxCell>

        <mxCell id="google" value="Google OAuth / OpenID Connect&#xa;openid, email, profile" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2130" y="145" width="225" height="70" as="geometry"/></mxCell>
        <mxCell id="llmproviders" value="LLM Providers via LiteLLM&#xa;Groq primary&#xa;Gemini + OpenRouter fallback&#xa;OpenAI/Anthropic keys supported by config" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2130" y="285" width="225" height="100" as="geometry"/></mxCell>
        <mxCell id="gmailservice" value="Gmail IMAP / SMTP&#xa;Per-business app-password credentials&#xa;Inbound mail + outbound replies/system email" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2130" y="455" width="225" height="90" as="geometry"/></mxCell>
        <mxCell id="env" value="Environment Configuration / Secrets&#xa;DATABASE_URL, SECRET_KEY, Qdrant host/port/collection, Meta/OAuth credentials, LLM keys/models, Gmail settings&#xa;No secret values exposed to ordinary frontend users" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2130" y="620" width="225" height="130" as="geometry"/></mxCell>
        <mxCell id="localfiles" value="Local File Storage&#xa;/uploads/attachments static mount&#xa;Chat image/file/audio attachments&#xa;Temporary document files during ingestion" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2130" y="820" width="225" height="100" as="geometry"/></mxCell>

        <mxCell id="legend" value="LEGEND&#xa;Solid border = implemented&#xa;Dashed border = planned / constrained / partial&#xa;Solid arrow = active data flow&#xa;Dashed arrow = planned / optional flow" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1090" width="390" height="125" as="geometry"/></mxCell>
        <mxCell id="notes" value="NOTES&#xa;• Facebook and Instagram integrations are implemented.&#xa;• WhatsApp awaits verified Meta Business access.&#xa;• PostgreSQL stores relational application data.&#xa;• Qdrant stores document embeddings and performs similarity retrieval.&#xa;• Primary AI-assisted flow keeps replies under human-agent supervision; optional auto mode is configurable in current code.&#xa;• Diagram reflects current source-code implementation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="1090" width="520" height="190" as="geometry"/></mxCell>
        <mxCell id="flowkey" value="NUMBERED FLOW KEY&#xa;M = inbound social message   A = AI-assisted reviewed reply   D = document indexing   T = authentication/tenant control" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1680" y="1090" width="700" height="100" as="geometry"/></mxCell>

